{
  "name": "taskflow-demo",
  "networks": {
    "default": {
      "name": "nafs-planner_default",
      "ipam": {}
    }
  },
  "services": {
    "admin": {
      "command": null,
      "depends_on": {
        "api": {
          "condition": "service_started",
          "required": true
        },
        "web": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": null,
      "networks": {
        "default": null
      },
      "restart": "always",
      "image": "taskflow-demo-admin:latest",
      "volumes": [
        {
          "type": "bind",
          "source": "./admin.Caddyfile",
          "target": "/etc/caddy/Caddyfile",
          "read_only": true
        }
      ],
      "build": {
        "context": ".",
        "dockerfile": "apps/admin/Dockerfile.demo"
      }
    },
    "api": {
      "command": [
        "bash",
        "-c",
        "python manage.py wait_for_migrations && python manage.py register_instance taskflow-demo-local && python manage.py configure_instance && python manage.py create_bucket && python manage.py collectstatic --noinput && exec gunicorn -w 1 -k uvicorn.workers.UvicornWorker plane.asgi:application --bind 0.0.0.0:8000 --access-logfile -"
      ],
      "depends_on": {
        "plane-db": {
          "condition": "service_started",
          "required": true
        },
        "plane-redis": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "ADMIN_BASE_PATH": "/god-mode",
        "ADMIN_BASE_URL": "${WEB_URL:-http://localhost:8080}",
        "AMQP_URL": "${AMQP_URL}",
        "API_KEY_RATE_LIMIT": "60/minute",
        "APP_BASE_PATH": "",
        "APP_BASE_URL": "${WEB_URL:-http://localhost:8080}",
        "AWS_ACCESS_KEY_ID": "${AWS_ACCESS_KEY_ID}",
        "AWS_REGION": "",
        "AWS_S3_BUCKET_NAME": "uploads",
        "AWS_S3_ENDPOINT_URL": "http://plane-minio:9000",
        "AWS_SECRET_ACCESS_KEY": "${AWS_SECRET_ACCESS_KEY}",
        "CORS_ALLOWED_ORIGINS": "${WEB_URL:-http://localhost:8080}",
        "DATABASE_URL": "${DATABASE_URL}",
        "DEBUG": "0",
        "DOCKERIZED": "1",
        "FILE_SIZE_LIMIT": "5242880",
        "GUNICORN_WORKERS": "2",
        "HARD_DELETE_AFTER_DAYS": "60",
        "LIVE_BASE_PATH": "/live",
        "LIVE_BASE_URL": "${WEB_URL:-http://localhost:8080}",
        "LIVE_SERVER_SECRET_KEY": "${LIVE_SERVER_SECRET_KEY}",
        "MINIO_ENDPOINT_SSL": "0",
        "POSTGRES_DB": "plane",
        "POSTGRES_HOST": "plane-db",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}",
        "POSTGRES_PORT": "5432",
        "POSTGRES_USER": "plane",
        "RABBITMQ_HOST": "plane-mq",
        "RABBITMQ_PASSWORD": "${RABBITMQ_PASSWORD}",
        "RABBITMQ_PORT": "5672",
        "RABBITMQ_USER": "plane",
        "RABBITMQ_VHOST": "plane",
        "REDIS_HOST": "plane-redis",
        "REDIS_PORT": "6379",
        "REDIS_URL": "redis://plane-redis:6379/",
        "SECRET_KEY": "${SECRET_KEY}",
        "SIGNED_URL_EXPIRATION": "3600",
        "SPACE_BASE_PATH": "/spaces",
        "SPACE_BASE_URL": "${WEB_URL:-http://localhost:8080}",
        "USE_MINIO": "1",
        "WEB_URL": "${WEB_URL:-http://localhost:8080}"
      },
      "networks": {
        "default": null
      },
      "restart": "always",
      "image": "taskflow-demo-api:latest",
      "volumes": [
        "./apps/api/templates:/code/templates:ro",
        "./apps/api/plane:/code/plane"
      ]
    },
    "beat-worker": {
      "command": [
        "./bin/docker-entrypoint-beat.sh"
      ],
      "depends_on": {
        "api": {
          "condition": "service_started",
          "required": true
        },
        "plane-db": {
          "condition": "service_started",
          "required": true
        },
        "plane-redis": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "ADMIN_BASE_PATH": "/god-mode",
        "ADMIN_BASE_URL": "${WEB_URL:-http://localhost:8080}",
        "AMQP_URL": "${AMQP_URL}",
        "API_KEY_RATE_LIMIT": "60/minute",
        "APP_BASE_PATH": "",
        "APP_BASE_URL": "${WEB_URL:-http://localhost:8080}",
        "AWS_ACCESS_KEY_ID": "${AWS_ACCESS_KEY_ID}",
        "AWS_REGION": "",
        "AWS_S3_BUCKET_NAME": "uploads",
        "AWS_S3_ENDPOINT_URL": "http://plane-minio:9000",
        "AWS_SECRET_ACCESS_KEY": "${AWS_SECRET_ACCESS_KEY}",
        "CORS_ALLOWED_ORIGINS": "${WEB_URL:-http://localhost:8080}",
        "DATABASE_URL": "${DATABASE_URL}",
        "DEBUG": "0",
        "DOCKERIZED": "1",
        "FILE_SIZE_LIMIT": "5242880",
        "GUNICORN_WORKERS": "2",
        "HARD_DELETE_AFTER_DAYS": "60",
        "LIVE_BASE_PATH": "/live",
        "LIVE_BASE_URL": "${WEB_URL:-http://localhost:8080}",
        "LIVE_SERVER_SECRET_KEY": "${LIVE_SERVER_SECRET_KEY}",
        "MINIO_ENDPOINT_SSL": "0",
        "POSTGRES_DB": "plane",
        "POSTGRES_HOST": "plane-db",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}",
        "POSTGRES_PORT": "5432",
        "POSTGRES_USER": "plane",
        "RABBITMQ_HOST": "plane-mq",
        "RABBITMQ_PASSWORD": "${RABBITMQ_PASSWORD}",
        "RABBITMQ_PORT": "5672",
        "RABBITMQ_USER": "plane",
        "RABBITMQ_VHOST": "plane",
        "REDIS_HOST": "plane-redis",
        "REDIS_PORT": "6379",
        "REDIS_URL": "redis://plane-redis:6379/",
        "SECRET_KEY": "${SECRET_KEY}",
        "SIGNED_URL_EXPIRATION": "3600",
        "SPACE_BASE_PATH": "/spaces",
        "SPACE_BASE_URL": "${WEB_URL:-http://localhost:8080}",
        "USE_MINIO": "1",
        "WEB_URL": "${WEB_URL:-http://localhost:8080}"
      },
      "networks": {
        "default": null
      },
      "restart": "always",
      "image": "taskflow-demo-api:latest",
      "volumes": [
        "./apps/api/templates:/code/templates:ro",
        "./apps/api/plane:/code/plane"
      ]
    },
    "live": {
      "command": null,
      "entrypoint": null,
      "networks": {
        "default": null
      },
      "restart": "always",
      "image": "taskflow-demo-live:latest",
      "environment": {
        "PORT": "3000",
        "API_BASE_URL": "http://api:8000",
        "LIVE_SERVER_SECRET_KEY": "${LIVE_SERVER_SECRET_KEY}",
        "REDIS_URL": "redis://plane-redis:6379/",
        "WEB_BASE_URL": "http://localhost:8080",
        "LIVE_BASE_PATH": "/live"
      }
    },
    "migrator": {
      "command": [
        "./bin/docker-entrypoint-migrator.sh"
      ],
      "depends_on": {
        "plane-db": {
          "condition": "service_started",
          "required": true
        },
        "plane-redis": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "ADMIN_BASE_PATH": "/god-mode",
        "ADMIN_BASE_URL": "${WEB_URL:-http://localhost:8080}",
        "AMQP_URL": "${AMQP_URL}",
        "API_KEY_RATE_LIMIT": "60/minute",
        "APP_BASE_PATH": "",
        "APP_BASE_URL": "${WEB_URL:-http://localhost:8080}",
        "AWS_ACCESS_KEY_ID": "${AWS_ACCESS_KEY_ID}",
        "AWS_REGION": "",
        "AWS_S3_BUCKET_NAME": "uploads",
        "AWS_S3_ENDPOINT_URL": "http://plane-minio:9000",
        "AWS_SECRET_ACCESS_KEY": "${AWS_SECRET_ACCESS_KEY}",
        "CORS_ALLOWED_ORIGINS": "${WEB_URL:-http://localhost:8080}",
        "DATABASE_URL": "${DATABASE_URL}",
        "DEBUG": "0",
        "DOCKERIZED": "1",
        "FILE_SIZE_LIMIT": "5242880",
        "GUNICORN_WORKERS": "2",
        "HARD_DELETE_AFTER_DAYS": "60",
        "LIVE_BASE_PATH": "/live",
        "LIVE_BASE_URL": "${WEB_URL:-http://localhost:8080}",
        "LIVE_SERVER_SECRET_KEY": "${LIVE_SERVER_SECRET_KEY}",
        "MINIO_ENDPOINT_SSL": "0",
        "POSTGRES_DB": "plane",
        "POSTGRES_HOST": "plane-db",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}",
        "POSTGRES_PORT": "5432",
        "POSTGRES_USER": "plane",
        "RABBITMQ_HOST": "plane-mq",
        "RABBITMQ_PASSWORD": "${RABBITMQ_PASSWORD}",
        "RABBITMQ_PORT": "5672",
        "RABBITMQ_USER": "plane",
        "RABBITMQ_VHOST": "plane",
        "REDIS_HOST": "plane-redis",
        "REDIS_PORT": "6379",
        "REDIS_URL": "redis://plane-redis:6379/",
        "SECRET_KEY": "${SECRET_KEY}",
        "SIGNED_URL_EXPIRATION": "3600",
        "SPACE_BASE_PATH": "/spaces",
        "SPACE_BASE_URL": "${WEB_URL:-http://localhost:8080}",
        "USE_MINIO": "1",
        "WEB_URL": "${WEB_URL:-http://localhost:8080}"
      },
      "networks": {
        "default": null
      },
      "restart": "no",
      "image": "taskflow-demo-api:latest"
    },
    "plane-db": {
      "command": [
        "postgres",
        "-c",
        "max_connections=1000"
      ],
      "entrypoint": null,
      "environment": {
        "API_KEY_RATE_LIMIT": "60/minute",
        "AWS_ACCESS_KEY_ID": "${AWS_ACCESS_KEY_ID}",
        "AWS_REGION": "",
        "AWS_S3_BUCKET_NAME": "uploads",
        "AWS_S3_ENDPOINT_URL": "http://plane-minio:9000",
        "AWS_SECRET_ACCESS_KEY": "${AWS_SECRET_ACCESS_KEY}",
        "CERT_ACME_CA": "https://acme-v02.api.letsencrypt.org/directory",
        "CERT_ACME_DNS": "",
        "CERT_EMAIL": "",
        "DOCKERIZED": "1",
        "FILE_SIZE_LIMIT": "5242880",
        "GPT_ENGINE": "gpt-3.5-turbo",
        "LISTEN_HTTPS_PORT": "8443",
        "LISTEN_HTTP_PORT": "8080",
        "MINIO_ENDPOINT_SSL": "0",
        "OPENAI_API_BASE": "https://api.openai.com/v1",
        "OPENAI_API_KEY": "${OPENAI_API_KEY}",
        "PGDATA": "/var/lib/postgresql/data",
        "POSTGRES_DB": "plane",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}",
        "POSTGRES_USER": "plane",
        "RABBITMQ_HOST": "plane-mq",
        "RABBITMQ_PASSWORD": "${RABBITMQ_PASSWORD}",
        "RABBITMQ_PORT": "5672",
        "RABBITMQ_USER": "plane",
        "RABBITMQ_VHOST": "plane",
        "REDIS_HOST": "plane-redis",
        "REDIS_PORT": "6379",
        "SITE_ADDRESS": ":80",
        "TRUSTED_PROXIES": "0.0.0.0/0",
        "USE_MINIO": "1"
      },
      "image": "postgres:15.7-alpine",
      "networks": {
        "default": null
      },
      "restart": "always",
      "volumes": [
        {
          "type": "volume",
          "source": "pgdata",
          "target": "/var/lib/postgresql/data",
          "volume": {}
        }
      ]
    },
    "plane-minio": {
      "command": [
        "/data"
      ],
      "entrypoint": null,
      "environment": {
        "RUSTFS_ACCESS_KEY": "${RUSTFS_ACCESS_KEY}",
        "RUSTFS_SECRET_KEY": "${RUSTFS_SECRET_KEY}"
      },
      "image": "rustfs/rustfs:latest",
      "networks": {
        "default": null
      },
      "restart": "always",
      "volumes": [
        {
          "type": "volume",
          "source": "uploads",
          "target": "/data"
        }
      ],
      "user": "0:0"
    },
    "plane-mq": {
      "command": null,
      "entrypoint": null,
      "environment": {
        "API_KEY_RATE_LIMIT": "60/minute",
        "AWS_ACCESS_KEY_ID": "${AWS_ACCESS_KEY_ID}",
        "AWS_REGION": "",
        "AWS_S3_BUCKET_NAME": "uploads",
        "AWS_S3_ENDPOINT_URL": "http://plane-minio:9000",
        "AWS_SECRET_ACCESS_KEY": "${AWS_SECRET_ACCESS_KEY}",
        "CERT_ACME_CA": "https://acme-v02.api.letsencrypt.org/directory",
        "CERT_ACME_DNS": "",
        "CERT_EMAIL": "",
        "DOCKERIZED": "1",
        "FILE_SIZE_LIMIT": "5242880",
        "GPT_ENGINE": "gpt-3.5-turbo",
        "LISTEN_HTTPS_PORT": "8443",
        "LISTEN_HTTP_PORT": "8080",
        "MINIO_ENDPOINT_SSL": "0",
        "OPENAI_API_BASE": "https://api.openai.com/v1",
        "OPENAI_API_KEY": "${OPENAI_API_KEY}",
        "PGDATA": "/var/lib/postgresql/data",
        "POSTGRES_DB": "plane",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}",
        "POSTGRES_USER": "plane",
        "RABBITMQ_DEFAULT_PASS": "${RABBITMQ_DEFAULT_PASS}",
        "RABBITMQ_DEFAULT_USER": "plane",
        "RABBITMQ_DEFAULT_VHOST": "plane",
        "RABBITMQ_HOST": "plane-mq",
        "RABBITMQ_PASSWORD": "${RABBITMQ_PASSWORD}",
        "RABBITMQ_PORT": "5672",
        "RABBITMQ_USER": "plane",
        "RABBITMQ_VHOST": "plane",
        "REDIS_HOST": "plane-redis",
        "REDIS_PORT": "6379",
        "SITE_ADDRESS": ":80",
        "TRUSTED_PROXIES": "0.0.0.0/0",
        "USE_MINIO": "1"
      },
      "image": "rabbitmq:3.13.6-management-alpine",
      "networks": {
        "default": null
      },
      "restart": "always",
      "volumes": [
        {
          "type": "volume",
          "source": "rabbitmq_data",
          "target": "/var/lib/rabbitmq",
          "volume": {}
        }
      ]
    },
    "plane-redis": {
      "command": null,
      "entrypoint": null,
      "image": "valkey/valkey:7.2.11-alpine",
      "networks": {
        "default": null
      },
      "restart": "always",
      "volumes": [
        {
          "type": "volume",
          "source": "redisdata",
          "target": "/data",
          "volume": {}
        }
      ]
    },
    "proxy": {
      "command": null,
      "depends_on": {
        "admin": {
          "condition": "service_started",
          "required": true
        },
        "api": {
          "condition": "service_started",
          "required": true
        },
        "web": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "BUCKET_NAME": "uploads",
        "FILE_SIZE_LIMIT": "5242880"
      },
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 80,
          "published": "8080",
          "protocol": "tcp",
          "host_ip": "127.0.0.1"
        },
        {
          "mode": "ingress",
          "target": 443,
          "published": "8443",
          "protocol": "tcp",
          "host_ip": "127.0.0.1"
        }
      ],
      "restart": "always",
      "image": "caddy:2.11.4-alpine",
      "volumes": [
        {
          "type": "bind",
          "source": "./proxy.Caddyfile",
          "target": "/etc/caddy/Caddyfile",
          "read_only": true
        }
      ]
    },
    "space": {
      "command": null,
      "depends_on": {
        "api": {
          "condition": "service_started",
          "required": true
        },
        "web": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": null,
      "networks": {
        "default": null
      },
      "restart": "always",
      "image": "taskflow-demo-space:latest",
      "build": {
        "context": ".",
        "dockerfile": "apps/space/Dockerfile.demo"
      }
    },
    "web": {
      "command": null,
      "depends_on": {
        "api": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": null,
      "networks": {
        "default": null
      },
      "restart": "always",
      "image": "taskflow-demo-web:latest",
      "volumes": [
        {
          "type": "bind",
          "source": "./web.Caddyfile",
          "target": "/etc/caddy/Caddyfile",
          "read_only": true
        },
        "./demo-assets:/usr/share/caddy/html/demo-projects:ro"
      ],
      "build": {
        "context": ".",
        "dockerfile": "apps/web/Dockerfile.demo"
      }
    },
    "worker": {
      "command": [
        "./bin/docker-entrypoint-worker.sh"
      ],
      "depends_on": {
        "api": {
          "condition": "service_started",
          "required": true
        },
        "plane-db": {
          "condition": "service_started",
          "required": true
        },
        "plane-redis": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "ADMIN_BASE_PATH": "/god-mode",
        "ADMIN_BASE_URL": "${WEB_URL:-http://localhost:8080}",
        "AMQP_URL": "${AMQP_URL}",
        "API_KEY_RATE_LIMIT": "60/minute",
        "APP_BASE_PATH": "",
        "APP_BASE_URL": "${WEB_URL:-http://localhost:8080}",
        "AWS_ACCESS_KEY_ID": "${AWS_ACCESS_KEY_ID}",
        "AWS_REGION": "",
        "AWS_S3_BUCKET_NAME": "uploads",
        "AWS_S3_ENDPOINT_URL": "http://plane-minio:9000",
        "AWS_SECRET_ACCESS_KEY": "${AWS_SECRET_ACCESS_KEY}",
        "CORS_ALLOWED_ORIGINS": "${WEB_URL:-http://localhost:8080}",
        "DATABASE_URL": "${DATABASE_URL}",
        "DEBUG": "0",
        "DOCKERIZED": "1",
        "FILE_SIZE_LIMIT": "5242880",
        "GUNICORN_WORKERS": "2",
        "HARD_DELETE_AFTER_DAYS": "60",
        "LIVE_BASE_PATH": "/live",
        "LIVE_BASE_URL": "${WEB_URL:-http://localhost:8080}",
        "LIVE_SERVER_SECRET_KEY": "${LIVE_SERVER_SECRET_KEY}",
        "MINIO_ENDPOINT_SSL": "0",
        "POSTGRES_DB": "plane",
        "POSTGRES_HOST": "plane-db",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}",
        "POSTGRES_PORT": "5432",
        "POSTGRES_USER": "plane",
        "RABBITMQ_HOST": "plane-mq",
        "RABBITMQ_PASSWORD": "${RABBITMQ_PASSWORD}",
        "RABBITMQ_PORT": "5672",
        "RABBITMQ_USER": "plane",
        "RABBITMQ_VHOST": "plane",
        "REDIS_HOST": "plane-redis",
        "REDIS_PORT": "6379",
        "REDIS_URL": "redis://plane-redis:6379/",
        "SECRET_KEY": "${SECRET_KEY}",
        "SIGNED_URL_EXPIRATION": "3600",
        "SPACE_BASE_PATH": "/spaces",
        "SPACE_BASE_URL": "${WEB_URL:-http://localhost:8080}",
        "USE_MINIO": "1",
        "WEB_URL": "${WEB_URL:-http://localhost:8080}"
      },
      "networks": {
        "default": null
      },
      "restart": "always",
      "image": "taskflow-demo-api:latest",
      "volumes": [
        "./apps/api/templates:/code/templates:ro",
        "./apps/api/plane:/code/plane"
      ]
    }
  },
  "volumes": {
    "pgdata": {
      "name": "nafs-planner_pgdata"
    },
    "rabbitmq_data": {
      "name": "nafs-planner_rabbitmq_data"
    },
    "redisdata": {
      "name": "nafs-planner_redisdata"
    },
    "uploads": {
      "name": "nafs-planner_uploads"
    }
  }
}
