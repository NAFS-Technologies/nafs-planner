# Copy to .env, replace all change-me values, then use docker-compose.demo.example.json.
# Never commit .env. These are placeholders, not production credentials.
WEB_URL=http://localhost:8080

# Application secrets: generate each independently with `openssl rand -hex 32`.
SECRET_KEY=change-me-django-secret
LIVE_SERVER_SECRET_KEY=change-me-live-secret

# Database. Keep DATABASE_URL synchronized with POSTGRES_PASSWORD.
POSTGRES_PASSWORD=change-me-database-password
DATABASE_URL=postgresql://plane:${POSTGRES_PASSWORD}@plane-db:5432/plane

# RabbitMQ. The application and broker must use the same password.
RABBITMQ_PASSWORD=change-me-rabbitmq-password
RABBITMQ_DEFAULT_PASS=${RABBITMQ_PASSWORD}
AMQP_URL=amqp://plane:${RABBITMQ_PASSWORD}@plane-mq:5672/plane

# S3-compatible RustFS. Application credentials must match storage credentials.
AWS_ACCESS_KEY_ID=taskflow-storage
AWS_SECRET_ACCESS_KEY=change-me-storage-secret
RUSTFS_ACCESS_KEY=${AWS_ACCESS_KEY_ID}
RUSTFS_SECRET_KEY=${AWS_SECRET_ACCESS_KEY}

# Optional; leave empty unless enabling the provider integration.
OPENAI_API_KEY=
